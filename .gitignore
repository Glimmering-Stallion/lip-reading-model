# ignore Python virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.lipread/
env/
lipread/

# ignore Python model checkpoints
LRM Python/models/checkpoint*

# ignore Rust target builds
**/target/

# JetBrains / PyCharm
.idea/

# Exported ONNX bundle (regenerate with `export`)
LRM Rust/exports/**/onnx/

# ignore OS system junk files
.DS_Store
__MACOSX/

# ignore large raw datasets and other misc.
data.zip
data/
test_frame.png

# ignore models (in both Python and Rust dirs)
**/models/

# catch large binary model files specifically (extra safety)
*.mpk
*.pt
*.pth
*.bin
checkpoint*

# ignore VSCode settings
.vscode/

# local shell configs
.zshrc
